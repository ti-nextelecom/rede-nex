# Reference only: never overwrite the existing VM .env with this example.
NODE_ENV=production
HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://rede_nex_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/rede_nex
REDE_NEX_EXPECTED_DATABASE=rede_nex
CORS_ORIGINS=https://rede.nextelecom.net.br
VITE_API_URL=/api

# Keep the CURRENT absolute persistent paths on an existing installation.
UPLOADS_DIR=/opt/rede-nex/uploads
JRH_UPLOADS_DIR=/opt/rede-nex/deploy_v2/uploads/jrh
PC_UPLOADS_DIR=/opt/rede-nex/deploy_v2/public/uploads/pc-anexos
DOWNLOADS_DIR=/opt/rede-nex/downloads

# API role must be NOSUPERUSER NOBYPASSRLS. For deployment only, supply
# REDE_NEX_MIGRATION_DATABASE_URL and REDE_NEX_BACKUP_DATABASE_URL through
# a protected operator environment; do not add privileged URLs to runtime.
# Preserve existing optional integration values. See README_DEPLOY_VM.md.
