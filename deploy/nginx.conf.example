# Incluir no contexto http (sites-enabled costuma estar dentro dele).
map $http_upgrade $nex_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name rede.nextelecom.net.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name rede.nextelecom.net.br;
    # Preserve os caminhos/configurações TLS já existentes; ajuste antes de nginx -t.
    ssl_certificate /etc/letsencrypt/live/rede.nextelecom.net.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rede.nextelecom.net.br/privkey.pem;
    root /opt/rede-nex/deploy_v2/dist;
    index index.html;
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location = /ws {
        proxy_pass http://127.0.0.1:3333;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nex_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:3333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    # Existing media is handled by the API. Do not expose backups or private PC attachments.
    location /uploads/ {
        proxy_pass http://127.0.0.1:3333;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ /\. { deny all; }
    location ~* \.(sql|dump|env|bak|log)$ { deny all; }
    location = /index.html { add_header Cache-Control 'no-store'; }
    location = /sw.js { add_header Cache-Control 'no-cache'; }
    location /assets/ { try_files $uri =404; add_header Cache-Control 'public, max-age=31536000, immutable'; }
    location / { try_files $uri $uri/ /index.html; }
}
